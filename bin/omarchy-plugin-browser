#!/usr/bin/env bash
#
# omarchy-plugin-browser — browse the Omarchy plugin marketplace from a
# terminal, and audit anything before it touches your shell.
#
# Reads the public catalog at plugins.omarchy.org as plain data (names, authors,
# tags, verification status, the install command the marketplace prints) and
# never executes anything from it. Every install path routes through
# `omarchy-plugin-audit`, which clones into a sandbox, pins to the verified
# commit, and scans — so the browser hands you a reviewed checkout, not a
# blind `omarchy plugin add`.
#
# Usage: omarchy-plugin-browser [--refresh] [--category <name>]
set -uo pipefail

# Only root-owned NixOS directories (Omarchy's commands live in sw/bin): nothing this
# script runs (git, jq, curl, bwrap, gum, omarchy) can be shadowed by an
# executable placed earlier on someone's PATH.
export PATH="/run/wrappers/bin:/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-}/bin"

SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# The auditor that ships next to this script, never one found on PATH.
AUDIT="$SELF_DIR/omarchy-plugin-audit"
[[ -f $AUDIT ]] || { echo "browser: omarchy-plugin-audit not found next to this script" >&2; exit 3; }

FORCE=0; ONLY_CAT=""
while (( $# )); do
  case "$1" in
    --refresh) FORCE=1; shift ;;
    --category) [[ -n ${2:-} && $2 != -* ]] || { echo "browser: --category needs a category name" >&2; exit 2; }
                ONLY_CAT=$2; shift 2 ;;
    -h|--help) sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; /^set -uo/d'; exit 0 ;;
    *) echo "browser: unknown option: $1" >&2; exit 2 ;;
  esac
done

for t in jq curl gum; do command -v "$t" >/dev/null || { echo "browser: missing required tool: $t" >&2; exit 3; }; done

# The spinner runs curl itself, so the download stays one bounded argv.
# shellcheck disable=SC2034  # read by lib/catalog.sh
CATALOG_RUNNER=(gum spin --spinner dot --title "Fetching the marketplace catalog…" --)
# shellcheck source=../lib/catalog.sh
source "$SELF_DIR/../lib/catalog.sh" || { echo "browser: lib/catalog.sh not found" >&2; exit 3; }

fetch() {
  local force=(); (( FORCE )) && force=(--force)
  fetch_catalog "${force[@]}" && return 0
  echo "browser: could not fetch a valid catalog (at most $((CATALOG_MAX_BYTES / 1048576)) MiB) and no cache present." >&2
  exit 3
}

show_detail() {  # $1 = id
  local name author repo cat stars vstat vcov vcommit upstream install avail note ver tags desc v
  # One jq for every field, NUL-separated (jq 1.7+): a field may be empty, and
  # catalog_detail passes every field through _s, so no field holds a NUL or a
  # control character. An unknown id gives no output: the first read fails.
  for v in name author repo cat stars ver vstat vcov vcommit upstream install avail note desc tags; do
    IFS= read -r -d '' "$v" || return
  done < <(catalog_detail "$1")

  local vline
  case "$vstat/$vcov" in
    verified/*)            vline="✔  verified snapshot, upstream matches" ;;
    */update-unverified)   vline="◐  snapshot verified, but a NEWER upstream commit is unverified" ;;
    *)                     vline="·  unverified (not a malware signal — just no automated check on record)" ;;
  esac

  gum style --border rounded --border-foreground 63 --padding "0 2" --margin "1 0" --width 76 \
    "$(gum style --bold "$name")  $(gum style --faint "v$ver")" \
    "$(gum style --faint "by $author   ·   $cat   ·   ★$stars")" \
    "" \
    "$(printf '%s' "$desc" | fold -s -w 72)" \
    "" \
    "$(gum style --faint "$tags")" \
    "" \
    "$vline" \
    "$(gum style --faint "verified  ${vcommit:0:12}    upstream  ${upstream:0:12}")" \
    "$(gum style --faint "repo  $repo")" \
    "$( [[ $avail != true && -n $note ]] && printf '\n%s' "$(gum style --foreground 214 "$(printf '%s' "note: $note" | fold -s -w 72)")" )"

  local actions=("🛡  Audit before install (sandboxed scan)" "🧩  NixOS check / fix with agent")
  [[ $avail == true && -n $install ]] && actions+=("📋  Copy install command")
  [[ -n $repo ]] && actions+=("🌐  Open repo in browser")
  actions+=("↩  Back")

  local choice
  choice=$(printf '%s\n' "${actions[@]}" | gum choose --header "  $name") || return
  case "$choice" in
    🛡*) run_tool "$AUDIT" "$1" ;;
    🧩*) run_tool "$SELF_DIR/nixarchy-plugin-fix" "$1" ;;
    📋*) printf '%s' "$install" | wl-copy 2>/dev/null && gum style --foreground 42 "  Copied:  $install" || echo "  $install"; gum input --placeholder "Enter to continue" >/dev/null 2>&1 || read -r _ ;;
    🌐*) [[ $repo == https://github.com/* ]] && omarchy launch browser "$repo" >/dev/null 2>&1 & ;;
    *) return ;;
  esac
}

# run_tool <script> <id>: run the audit or nixarchy-plugin-fix (which asks
# explain / fix / back itself) in this same terminal, so its report stays on
# screen until Enter. The id is validated to the plugin-id charset first.
run_tool() {
  local script="$1" id="$2"
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { gum style --foreground 196 "  refusing suspicious id"; return; }
  echo
  /run/current-system/sw/bin/bash "$script" "$id"
  echo
  gum input --placeholder "Enter to return to the list" >/dev/null 2>&1 || read -r _
}

main() {
  fetch
  local total; total=$(jq '.plugins | map(select(.sourceType=="community")) | length' "$CATALOG")
  while true; do
    local line id
    line=$(catalog_lines "$ONLY_CAT" | gum filter --height 20 --prompt "🔎 " \
      --placeholder "Search $total plugins by name, author, tag, category…  (Esc to quit)" \
      --indicator "▸" --header "Omarchy plugin marketplace   ✔ verified   ◐ snapshot-verified, update pending   · unverified") || break
    id="${line##* }"                 # id is the final whitespace-delimited token
    [[ -n $id ]] && show_detail "$id"
  done
}
main
